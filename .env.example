# 模型（使用 DOCTOR_ENGINE=fake 时可暂不配置）
DEEPSEEK_API_KEY=sk-your-key

# 飞书企业自建应用凭证
FEISHU_APP_ID=cli_your_app_id
FEISHU_APP_SECRET=your_app_secret

# 可选：默认分别为项目的 samples/ 和项目根目录
# DOCTOR_LOG_DIR=D:\path\to\logs
# DOCTOR_REPO_DIR=D:\path\to\repository

# 可选：业务仓库映射（repoId → 仓库目录；容器部署时指向挂载的 bare 镜像路径）
# DOCTOR_REPOS={"backend":"/srv/mirrors/backend.git","frontend":"/srv/mirrors/web.git"}

# 可选：容器/反向代理部署时让 HTTP 服务监听所有网卡（默认仅 127.0.0.1）
# HOST=0.0.0.0

# 可选：Skill 目录与显式指定（默认 <项目根>/skills，容器内为 /app/skills）
# DOCTOR_SKILLS_DIR=/app/skills
# DOCTOR_SKILL_ID=ticket-triage
